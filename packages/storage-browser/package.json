{
  "name": "@nexus/storage-browser",
  "version": "0.1.0",
  "description": "Headless Nexus storage client + explorer/mount model (buckets, capability fallbacks, mount plan) shared by the desktop app, the nexus CLI and the mount daemon",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nexus/files-core": "file:../../../anx-npm-modules/packages/files-core"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
