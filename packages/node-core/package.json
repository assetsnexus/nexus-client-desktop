{
  "name": "@nexus/node-core",
  "version": "0.1.0",
  "description": "Headless Nexus client core shared by the desktop app and the nexus CLI (config, device keys, secure storage, region transport)",
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@nexus/commands-client": "file:../../../anx-npm-modules/packages/commands-client"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
