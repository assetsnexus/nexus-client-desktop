{
  "name": "nexus-desktop",
  "private": true,
  "version": "0.1.0",
  "description": "Nexus desktop client (Electron shell + renderer)",
  "license": "SEE LICENSE IN LICENSE.md",
  "author": {
    "name": "AssetsNexus",
    "email": "desktop@assetsnexus.org"
  },
  "homepage": "https://assetsnexus.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/assetsnexus/nexus-desktop.git"
  },
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "node scripts/build-main.mjs",
    "build:renderer": "vite build",
    "build:native": "node scripts/build-native.mjs",
    "native:test": "cargo test --manifest-path ../../native/Cargo.toml && node ../../native/smoke-mount.mjs ../../native/target/release/nexus-mount",
    "package": "npm run build && npm run build:native && electron-builder --publish never",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.renderer.json --noEmit"
  },
  "dependencies": {
    "@nexus/asset-agent-discovery": "file:../../packages/asset-agent-discovery",
    "@nexus/calendar-client": "file:../../packages/calendar-client",
    "@nexus/character-kit": "file:../../../anx-libs/nexus-collaboration-vr/packages/character-kit",
    "@nexus/character-react": "file:../../../anx-libs/nexus-collaboration-vr/packages/character-react",
    "@nexus/chat-core": "file:../../../anx-npm-modules/packages/chat-core",
    "@nexus/chat-react": "file:../../../anx-npm-modules/packages/chat-react",
    "@nexus/client-tools": "file:../../packages/client-tools",
    "@nexus/cluster-scene-react": "file:../../../anx-libs/nexus-collaboration-vr/packages/cluster-scene-react",
    "@nexus/identity": "file:../../packages/identity",
    "@nexus/local-runner": "file:../../packages/local-runner",
    "@nexus/local-voice": "file:../../packages/local-voice",
    "@nexus/meetings-core": "file:../../../anx-npm-modules/packages/meetings-core",
    "@nexus/meetings-react": "file:../../../anx-npm-modules/packages/meetings-react",
    "@nexus/node-core": "file:../../packages/node-core",
    "@nexus/scene-client": "file:../../../anx-npm-modules/packages/scene-client",
    "@nexus/storage-browser": "file:../../packages/storage-browser",
    "@nexus/wake-word": "file:../../../anx-npm-modules/packages/wake-word",
    "@pixiv/three-vrm": "^3.5.5",
    "@pixiv/three-vrm-animation": "^3.5.5",
    "bonjour-service": "^1.4.4",
    "onnxruntime-web": "^1.30.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.170.0",
    "three-vrm-lip-sync": "^0.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "33.4.11",
    "electron-builder": "^25.1.8",
    "esbuild": "^0.21.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.4"
  }
}
