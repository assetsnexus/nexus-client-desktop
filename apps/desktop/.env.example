# Nexus desktop client — local development overrides
#
# Copy to `.env` in the app directory (apps/desktop/) to point this client at a
# locally-running region node and portal instead of the sandbox. Real shell
# environment variables always win over this file, so you can override any line
# with an `export` for a one-off run.
#
# Precedence: real env vars > this file > built-in sandbox defaults.
#
# The values below match the local dev stack documented in
# anx-region-node_2/RUN_DEV.md (region REST :3005, portal dev server :8080).

# Region node REST base URL.
#
# NOTE: the local region node serves REST over HTTPS (its `endpoints.yaml` has
# `rest.ssl.enabled: true`), so use `https://`, not `http://` — plain HTTP to a
# TLS listener fails with an empty reply ("fetch failed").
#
# Use 127.0.0.1, not localhost: the dev cert's SANs are
# `DNS:alexlab-ws-i9, IP:192.168.110.220, IP:192.168.1.197, IP:127.0.0.1` —
# `localhost` is NOT in the list and would fail hostname verification.
NEXUS_REGION_URL=https://127.0.0.1:3005

# Portal base URL (used for register / "open in portal" links).
NEXUS_PORTAL_URL=http://localhost:8080

# Trust the local region's self-signed CA. Accepts inline PEM or a path to a PEM
# file. The dev cert is issued by the AlexLab CA, so trust that (not the leaf):
#   openssl verify -CAfile alexlab.crt main.crt   # -> OK
# NEXUS_CUSTOM_CA_FILE=./certs/alexlab.crt

# Optional: gateway registry URL. Defaults to the region URL when unset.
# NEXUS_GATEWAY_URL=https://127.0.0.1:3005

# Optional: path to this file, when you keep it outside the app directory.
# NEXUS_ENV_FILE=/abs/path/to/.env
